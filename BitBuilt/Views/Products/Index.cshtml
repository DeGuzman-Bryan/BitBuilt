@model List<Product>
@{
    ViewData["Title"] = "List of Products";
}

<style>
    body {
        background: url('/products/3408105.jpg') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        color: #00bfae;
        font-weight: bold;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
    }

    .table {
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

        .table thead {
            background-color: #00bfae;
            color: white;
        }

        .table th, .table td {
            vertical-align: middle;
            text-align: center;
        }

        .table tbody tr:hover {
            background-color: #e0f7fa;
        }

    .btn {
        border-radius: 20px;
    }

    .btn-primary {
        background-color: #00bfae;
        border: none;
    }

        .btn-primary:hover {
            background-color: #008e82;
        }

    .btn-danger {
        border: none;
        background-color: #f44336;
    }

        .btn-danger:hover {
            background-color: #d32f2f;
        }

    img {
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
</style>

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<div class="row mb-4">
    <div class="col text-start">
        <a class="btn btn-primary px-4" asp-controller="Products" asp-action="Create">➕ New Product</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Brand</th>
                <th>Category</th>
                <th>Price</th>
                <th>Image</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Brand</td>
                    <td>@product.Category</td>
                    <td><strong>@product.Price</strong> ₱</td>
                    <td>
                        <img src="/products/@product.ImageFileName" width="100" alt="@product.Name" />
                    </td>
                    <td>@product.CreatedAt.ToString("MM/dd/yyyy")</td>
                    <td>
                        <a class="btn btn-sm btn-primary me-1"
                           asp-controller="Products"
                           asp-action="Edit"
                           asp-route-id="@product.Id">Edit</a>
                        <a class="btn btn-sm btn-danger"
                           asp-controller="Products"
                           asp-action="Delete"
                           asp-route-id="@product.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
