@{
    ViewData["Title"] = "Compare Products";
}

<style>
    /* Overall Page Design */
    body {
        background-color: #101010;
        color: #e0e0e0;
        font-family: 'Arial', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        text-align: center;
    }

    h1 {
        font-size: 3rem;
        color: #00bfae;
        font-weight: bold;
        text-shadow: 2px 2px 8px rgba(0, 191, 174, 0.5);
    }

    p {
        font-size: 1.25rem;
        color: #b0b0b0;
        margin-top: 20px;
    }

    .btn-compare {
        background-color: #00bfae;
        color: white;
        padding: 15px 30px;
        font-size: 1.25rem;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
        margin-top: 20px;
    }

        .btn-compare:hover {
            background-color: #007b80;
            transform: scale(1.05);
        }

    /* Banner Section */
    .banner {
        background: linear-gradient(135deg, #00bfae, #007b80);
        padding: 50px 0;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        margin-bottom: 40px;
    }

        /* Styling for the image */
        .banner img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);
            margin-top: 20px;
        }

    .content-section {
        background-color: #2b2b2b;
        padding: 40px;
        border-radius: 10px;
        margin-top: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

        .content-section h2 {
            color: #fff;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .content-section p {
            color: #ccc;
            font-size: 1.15rem;
        }
</style>

<div class="container">
    <!-- Banner Section -->
    <div class="banner">
        <h1>Compare Your PC Components</h1>
        <p>Here you can compare different PC components, view their specs, and make an informed decision.</p>

        <!-- Placeholder for Image (Replace with actual image name) -->
        <img src="~/products/comp.png" alt="PC Components" />
    </div>

    <!-- Button that redirects to UserBenchmark's PCBuilder -->
    <a href="https://www.userbenchmark.com/PCBuilder" style="display: inline-block;">
        <button class="btn-compare">Click to Compare PC Parts Build</button>
    </a>

    <!-- Additional Content Section -->
    <div class="content-section">
        <h2>Why Use Our Compare Tool?</h2>
        <p>Our tool helps you to easily compare different PC parts, ensuring that you get the best components for your needs. Save time and make an informed decision with comprehensive data and specs.</p>
    </div>
</div>
